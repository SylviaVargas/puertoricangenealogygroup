---
layout: null
---
{% assign searchable_pages = "" | split: "" %}
{% for page in site.pages %}
  {% if page.title and page.lang and page.url != "/search.json" %}
    {% assign searchable_pages = searchable_pages | push: page %}
  {% endif %}
{% endfor %}
[
{% for page in searchable_pages %}
  {
    "title": {{ page.title | jsonify }},
    "url": {{ page.url | relative_url | jsonify }},
    "lang": {{ page.lang | jsonify }},
    "ref": {{ page.ref | default: "" | jsonify }},
    "content": {{ page.content | strip_html | strip_newlines | truncatewords: 200 | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]
